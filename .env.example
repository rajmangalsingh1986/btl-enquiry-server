# Neon (or any Postgres) connection strings - see README "Database setup"
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require"

# Any long random string
JWT_SECRET="change-me"

PORT=4000

# Daily emailed dashboard report - see README "Daily emailed dashboard"
SMTP_USER="you@gmail.com"
SMTP_APP_PASSWORD="16-character Google App Password, not your real Gmail password"
REPORT_RECIPIENTS="person1@example.com,person2@example.com"
REPORT_CRON_SECRET="any long random string - matches the secret the external cron pinger sends"
