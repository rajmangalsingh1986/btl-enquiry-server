generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection for normal app queries.
  url       = env("DATABASE_URL")
  // Direct (non-pooler) connection, used only for migrations.
  directUrl = env("DIRECT_URL")
}

// Roles and stage/status values are plain strings validated in the route
// handlers (see src/routes), matching the convention used in the Sales
// Pipeline Management app this is designed to eventually merge into.

model Dealership {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  location  String?
  state     String?
  createdAt DateTime @default(now())

  users     User[]
  enquiries Enquiry[]
  asmUsers  User[] @relation("AsmDealerships")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         String // SC | CRE | SM | ASM | ADMIN
  dealershipId Int? // single dealership for SC/CRE/SM; null for ADMIN and ASM
  // Meaningful only for CRE/SM: "Personal" | "Commercial" | null. Null means
  // not specialized - sees enquiries of every segment at their dealership.
  // BEV-segment enquiries always route with "Personal".
  segment      String?
  createdAt    DateTime @default(now())

  dealership       Dealership?  @relation(fields: [dealershipId], references: [id])
  // ASM covers an "area" - multiple dealerships - instead of the single
  // dealership everyone else is scoped to. Unused for other roles.
  asmDealerships   Dealership[] @relation("AsmDealerships")
  enquiriesCreated Enquiry[]  @relation("EnquiryCreatedBy")
  enquiriesCre     Enquiry[]  @relation("EnquiryCreUser")
  enquiriesSm      Enquiry[]  @relation("EnquirySmUser")
  enquiriesAsm     Enquiry[]  @relation("EnquiryAsmUser")
}

model Enquiry {
  id         Int     @id @default(autoincrement())
  clientUuid String? @unique

  activityName           String
  location               String
  activityDate            DateTime
  dealershipId            Int
  customerName            String
  contactNo               String
  profile                 String
  segment                 String
  application             String?
  currentVehicle          String?
  vehicleModelInterested  String
  variant                 String?
  exchangeInterested      Boolean  @default(false)

  stage String @default("CREATED") // CREATED | CRE_TAGGED | SM_TAGGED | ASM_TAGGED

  creValidation String?
  creTag        String?
  creRemarks    String?
  creUserId     Int?
  creTaggedAt   DateTime?

  smStatus    String?
  smRemarks   String?
  smUserId    Int?
  smTaggedAt  DateTime?

  // Final/closing tag. Despite the "asm" field names (kept for continuity
  // with the original 4-role design), this is now set by an SM user - ASM
  // is view/download-only and no longer performs any tagging.
  asmStatus   String?
  asmRemarks  String?
  asmUserId   Int?
  asmTaggedAt DateTime?

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dealership Dealership @relation(fields: [dealershipId], references: [id])
  createdBy  User       @relation("EnquiryCreatedBy", fields: [createdById], references: [id])
  creUser    User?      @relation("EnquiryCreUser", fields: [creUserId], references: [id])
  smUser     User?      @relation("EnquirySmUser", fields: [smUserId], references: [id])
  asmUser    User?      @relation("EnquiryAsmUser", fields: [asmUserId], references: [id])

  @@index([stage])
  @@index([dealershipId])
}
